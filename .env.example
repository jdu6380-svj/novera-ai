NEXT_PUBLIC_SUPABASE_URL=
# Preferred browser-safe key for new Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, still supported for existing projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1 uses the private `knowledge-files` bucket created by the storage migration.
SUPABASE_STORAGE_BUCKET=knowledge-files
MAX_DOCUMENT_SIZE_BYTES=20971520
DEFAULT_KNOWLEDGE_BASE_ID=00000000-0000-4000-8000-000000000001

# Phase 2 server-only embedding configuration.
# Use a dedicated embedding key so generation can use a different provider.
EMBEDDING_API_KEY=
OPENAI_API_KEY=
# Optional for OpenAI-compatible embedding endpoints; omit when using the OpenAI API.
EMBEDDING_BASE_URL=
OPENAI_BASE_URL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Audit label for the exact deployment/revision; defaults to EMBEDDING_MODEL.
EMBEDDING_MODEL_VERSION=text-embedding-3-small
# Must match the pgvector column declared by the database migration.
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# Phase 4 structured answer generation.
LANGUAGE_MODEL_PROVIDER=deepseek
LANGUAGE_MODEL=deepseek-flash
# Required when LANGUAGE_MODEL_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LANGUAGE_MODEL_PROMPT_VERSION=phase4-v1
LANGUAGE_MODEL_MAX_OUTPUT_TOKENS=1600

# Auditable cost assumptions used in QA responses and portfolio evaluation.
# Override these values when provider pricing changes. DeepSeek defaults below
# are conservative peak-hour, uncached input rates for deepseek-flash.
EMBEDDING_INPUT_COST_USD_PER_1M_TOKENS=0.02
LANGUAGE_MODEL_INPUT_COST_USD_PER_1M_TOKENS=0.30
LANGUAGE_MODEL_OUTPUT_COST_USD_PER_1M_TOKENS=1.20
QA_COST_PRICING_SOURCE=deepseek-flash-peak-cache-miss-2026-09-23

# Phase 5/6 live product and end-to-end staging verification. QA_SMOKE_URL must point to the
# deployed Novera application using the same Supabase project configured above.
QA_SMOKE_URL=
QA_SMOKE_KNOWLEDGE_BASE_ID=00000000-0000-4000-8000-000000000001
QA_SMOKE_QUERY=
# Optional Phase 6 polling/request limits in milliseconds.
PHASE6_SMOKE_TIMEOUT_MS=240000
PHASE6_SMOKE_REQUEST_TIMEOUT_MS=150000

# Phase 3 retrieval and bounded prompt-context controls.
RETRIEVAL_DEFAULT_TOP_K=12
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
RETRIEVAL_MAX_QUERY_CHARACTERS=4000

# Phase 2 processing and structured chunking.
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_CHUNK_MAX_TOKENS=400
PROCESSING_CHUNK_OVERLAP_TOKENS=60
